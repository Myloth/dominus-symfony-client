{% extends 'components/datatables/base.html.twig' %}
{% trans_default_domain 'users' %}

{% block search_form %}
    <div class="form-row">
        <div class="form-group col-md-4">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
        </div>
        <div class="form-group">
            {{ form_label(form.group) }}
            {{ form_widget(form.group) }}
        </div>
    </div>
{% endblock %}

{% block itemLines %}
    {% for user in this.items %}
        <tr>
            <td>{{ user.id }}</td>
            <td>{{ user.username }}</td>
            <td>
                {% include 'admin/user/user/_groups_column.html.twig' with {entity: user} %}
            </td>
            <td></td>
        </tr>
    {% endfor %}
{% endblock %}
