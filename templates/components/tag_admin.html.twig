<div {{ attributes }} class="tag-admin-container">
    {% set availableEntityTypes = this.availableEntityTypes %}

    {# Notifications #}
    {% if this.flash %}
        <div class="alert alert-{{ this.flash.type }}">
            <div class="alert-content">
                {{ ux_icon(this.flash.type == 'success' ? 'fa-solid:check-circle' : 'fa-solid:exclamation-triangle') }}
                <span>{{ this.flash.message }}</span>
            </div>
            <button type="button" class="alert-close" data-action="live#action" data-live-action-param="dismissFlash">
                {{ ux_icon('fa-solid:times') }}
            </button>
        </div>
    {% endif %}

    {# Filter & Search Bar #}
    <section class="tag-search-card">
        <div class="search-fields-grid">
            <div class="filter-field">
                <label for="filter-name">Nom du tag</label>
                <div class="input-with-icon">
                    {{ ux_icon('fa-solid:search') }}
                    <input
                        id="filter-name"
                        type="text"
                        placeholder="Rechercher par nom..."
                        data-model="debounce(250)|search.name"
                        value="{{ this.search.name }}"
                    >
                </div>
            </div>

            <div class="filter-field">
                <label for="filter-slug">Slug</label>
                <div class="input-with-icon">
                    {{ ux_icon('fa-solid:tag') }}
                    <input
                        id="filter-slug"
                        type="text"
                        placeholder="Rechercher par slug..."
                        data-model="debounce(250)|search.slug"
                        value="{{ this.search.slug }}"
                    >
                </div>
            </div>

            <div class="filter-field">
                <label for="filter-entity-type">Type d'entité</label>
                <select id="filter-entity-type" data-model="search.entityType">
                    <option value="">Tous les types</option>
                    {% for entityType in availableEntityTypes %}
                        <option value="{{ entityType.slug }}" {{ this.search.entityType == entityType.slug ? 'selected' : '' }}>
                            {{ entityType.name }} ({{ entityType.slug }})
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-actions-col">
                <label>&nbsp;</label>
                <button
                    type="button"
                    class="btn-reset-filters"
                    data-action="live#action"
                    data-live-action-param="resetFilters"
                    title="Réinitialiser les filtres"
                >
                    {{ ux_icon('fa-solid:undo') }} Réinitialiser
                </button>
            </div>
        </div>
    </section>

    {# Table Card #}
    {% set paginatedData = this.tags %}
    <section class="tag-table-card">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <span class="tags-count-badge">
                    {{ ux_icon('fa-solid:tags') }}
                    <strong>{{ paginatedData.totalItems }}</strong> tag{{ paginatedData.totalItems > 1 ? 's' : '' }} au total
                </span>
                <span class="loading-indicator" data-loading>
                    {{ ux_icon('fa-solid:spinner', {class: 'fa-spin'}) }} Chargement...
                </span>
            </div>

            <div class="toolbar-right">
                <button
                    type="button"
                    class="btn-primary"
                    data-action="live#action"
                    data-live-action-param="openCreateModal"
                >
                    {{ ux_icon('fa-solid:plus') }} Créer un tag
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="tag-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Slug</th>
                        <th>Types d'entité</th>
                        <th>Catégorie</th>
                        <th>Date de création</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tag in paginatedData.items %}
                        <tr>
                            <td class="col-name">
                                <strong>{{ tag.name }}</strong>
                            </td>
                            <td class="col-slug">
                                <code class="tag-slug-pill">{{ tag.slug }}</code>
                            </td>
                            <td class="col-entity">
                                {% set tagEntityTypes = tag.normalizedEntityTypes %}
                                {% if tagEntityTypes is not empty %}
                                    <div class="entity-badges-list">
                                        {% for entityType in tagEntityTypes %}
                                            <span class="entity-badge entity-badge-{{ entityType.slug }}">
                                                {{ entityType.name ?? entityType.slug }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="col-category">
                                {% if tag.category %}
                                    <span class="category-pill">{{ tag.category }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="col-date">
                                {{ tag.formattedCreatedAt }}
                            </td>
                            <td class="col-actions text-right">
                                <button
                                    type="button"
                                    class="action-btn action-edit"
                                    title="Modifier le tag"
                                    data-action="live#action"
                                    data-live-action-param="openEditModal"
                                    data-live-id-param="{{ tag.id }}"
                                >
                                    {{ ux_icon('fa-solid:pen') }} Modifier
                                </button>
                                <button
                                    type="button"
                                    class="action-btn action-delete"
                                    title="Supprimer le tag"
                                    data-action="live#action"
                                    data-live-action-param="confirmDelete"
                                    data-live-id-param="{{ tag.id }}"
                                    data-live-name-param="{{ tag.name }}"
                                >
                                    {{ ux_icon('fa-solid:trash-alt') }} Supprimer
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="empty-state">
                                <div class="empty-state-inner">
                                    {{ ux_icon('fa-solid:folder-open', {class: 'empty-icon'}) }}
                                    <h3>Aucun tag trouvé</h3>
                                    <p>Aucun tag ne correspond à vos critères de recherche.</p>
                                    {% if this.hasActiveFilters %}
                                        <button
                                            type="button"
                                            class="btn-reset-filters"
                                            data-action="live#action"
                                            data-live-action-param="resetFilters"
                                        >
                                            {{ ux_icon('fa-solid:undo') }} Réinitialiser les filtres
                                        </button>
                                    {% else %}
                                        <button
                                            type="button"
                                            class="btn-primary"
                                            data-action="live#action"
                                            data-live-action-param="openCreateModal"
                                        >
                                            {{ ux_icon('fa-solid:plus') }} Créer le premier tag
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination Section #}
        {% if paginatedData.totalItems > 0 %}
            <div class="table-pagination-bar">
                <div class="pagination-info">
                    Affichage de <strong>{{ paginatedData.startIndex }}</strong> à <strong>{{ paginatedData.endIndex }}</strong> sur <strong>{{ paginatedData.totalItems }}</strong> tags
                </div>

                <div class="pagination-controls">
                    <div class="per-page-selector">
                        <label for="items-per-page">Par page :</label>
                        <select id="items-per-page" data-model="search.itemsPerPage">
                            <option value="5" {{ this.search.itemsPerPage == 5 ? 'selected' : '' }}>5</option>
                            <option value="10" {{ this.search.itemsPerPage == 10 ? 'selected' : '' }}>10</option>
                            <option value="25" {{ this.search.itemsPerPage == 25 ? 'selected' : '' }}>25</option>
                            <option value="50" {{ this.search.itemsPerPage == 50 ? 'selected' : '' }}>50</option>
                        </select>
                    </div>

                    {% if paginatedData.totalPages > 1 %}
                        <ul class="pagination-list">
                            <li>
                                <button
                                    type="button"
                                    class="page-link {{ not paginatedData.hasPreviousPage ? 'disabled' : '' }}"
                                    {{ not paginatedData.hasPreviousPage ? 'disabled' : '' }}
                                    data-action="live#action"
                                    data-live-action-param="setPage"
                                    data-live-page-param="{{ this.search.page - 1 }}"
                                >
                                    {{ ux_icon('fa-solid:chevron-left') }} Précédent
                                </button>
                            </li>

                            {% for p in 1..paginatedData.totalPages %}
                                {% if p == 1 or p == paginatedData.totalPages or (p >= this.search.page - 2 and p <= this.search.page + 2) %}
                                    <li>
                                        <button
                                            type="button"
                                            class="page-link {{ p == this.search.page ? 'active' : '' }}"
                                            data-action="live#action"
                                            data-live-action-param="setPage"
                                            data-live-page-param="{{ p }}"
                                        >
                                            {{ p }}
                                        </button>
                                    </li>
                                {% elseif p == this.search.page - 3 or p == this.search.page + 3 %}
                                    <li class="page-ellipsis">...</li>
                                {% endif %}
                            {% endfor %}

                            <li>
                                <button
                                    type="button"
                                    class="page-link {{ not paginatedData.hasNextPage ? 'disabled' : '' }}"
                                    {{ not paginatedData.hasNextPage ? 'disabled' : '' }}
                                    data-action="live#action"
                                    data-live-action-param="setPage"
                                    data-live-page-param="{{ this.search.page + 1 }}"
                                >
                                    Suivant {{ ux_icon('fa-solid:chevron-right') }}
                                </button>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>

    {# Modal Create / Edit Tag #}
    {% if this.isModalOpen %}
        <div class="modal-backdrop-custom" data-action="click->live#action" data-live-action-param="closeModal"></div>
        <div class="modal-dialog-custom" role="dialog" aria-modal="true" aria-labelledby="modal-tag-title">
            <div class="modal-header-custom">
                <h3 id="modal-tag-title">
                    {{ ux_icon(this.form.id ? 'fa-solid:edit' : 'fa-solid:plus-circle') }}
                    {{ this.form.id ? 'Modifier le tag' : 'Créer un nouveau tag' }}
                </h3>
                <button
                    type="button"
                    class="modal-close-btn"
                    data-action="live#action"
                    data-live-action-param="closeModal"
                    aria-label="Fermer"
                >
                    {{ ux_icon('fa-solid:times') }}
                </button>
            </div>

            <form data-action="submit->live#action:prevent" data-live-action-param="save">
                <div class="modal-body-custom">

                    {# Nom field #}
                    <div class="modal-form-group {{ this.validationErrors.name is defined ? 'has-error' : '' }}">
                        <label for="form-tag-name">
                            Nom <span class="required-star">*</span>
                        </label>
                        <input
                            id="form-tag-name"
                            type="text"
                            placeholder="ex: Quête Principale"
                            data-model="form.name"
                            value="{{ this.form.name }}"
                            autofocus
                        >
                        {% if this.validationErrors.name is defined %}
                            <span class="field-error-msg">{{ this.validationErrors.name }}</span>
                        {% else %}
                            <small class="field-hint">
                                {% if this.form.id and this.form.slug %}
                                    Le slug est généré par l'API (slug actuel : <code>{{ this.form.slug }}</code>).
                                {% else %}
                                    Le slug sera généré automatiquement par l'API à partir du nom.
                                {% endif %}
                            </small>
                        {% endif %}
                    </div>

                    {# Types d'entité field (multi-select with TomSelect) #}
                    <div class="modal-form-group {{ this.validationErrors.entityTypes is defined ? 'has-error' : '' }}">
                        <label for="form-tag-entity-types">
                            Types d'entité <span class="required-star">*</span>
                        </label>
                        {% if availableEntityTypes is not empty %}
                            <div class="tom-select-container" data-live-ignore>
                                <select
                                    id="form-tag-entity-types"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Rechercher et sélectionner des types d'entité..."
                                    data-model="norender|form.entityTypes"
                                    multiple
                                >
                                    {% for entityType in availableEntityTypes %}
                                        {% set typeIri = entityType.iri %}
                                        <option value="{{ typeIri }}" {{ typeIri in this.form.entityTypes ? 'selected' : '' }}>
                                            {{ entityType.name }} ({{ entityType.slug }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% else %}
                            <div class="empty-entity-types-notice">
                                {{ ux_icon('fa-solid:info-circle') }}
                                <span>Aucun type d'entité n'a pu être récupéré depuis l'API.</span>
                            </div>
                        {% endif %}

                        {% if this.validationErrors.entityTypes is defined %}
                            <span class="field-error-msg">{{ this.validationErrors.entityTypes }}</span>
                        {% else %}
                            <small class="field-hint">Sélectionnez un ou plusieurs types d'entité pour ce tag.</small>
                        {% endif %}
                    </div>

                    {# Catégorie field #}
                    <div class="modal-form-group">
                        <label for="form-tag-category">
                            Catégorie <span class="optional-tag">(optionnel)</span>
                        </label>
                        <input
                            id="form-tag-category"
                            type="text"
                            placeholder="ex: histoire, boss, journaliere..."
                            data-model="form.category"
                            value="{{ this.form.category }}"
                        >
                        <small class="field-hint">Permet de sous-classer les tags pour une même entité.</small>
                    </div>

                </div>

                <div class="modal-footer-custom">
                    <button
                        type="button"
                        class="btn-secondary"
                        data-action="live#action"
                        data-live-action-param="closeModal"
                    >
                        Annuler
                    </button>
                    <button
                        type="submit"
                        class="btn-primary"
                    >
                        {{ ux_icon('fa-solid:check') }}
                        {{ this.form.id ? 'Enregistrer les modifications' : 'Créer le tag' }}
                    </button>
                </div>
            </form>
        </div>
    {% endif %}

    {# Modal Confirmation Delete #}
    {% if this.deletingTag %}
        <div class="modal-backdrop-custom" data-action="click->live#action" data-live-action-param="cancelDelete"></div>
        <div class="modal-dialog-custom modal-confirm-danger" role="dialog" aria-modal="true">
            <div class="modal-header-custom danger-header">
                <h3>
                    {{ ux_icon('fa-solid:exclamation-triangle') }} Confirmer la suppression
                </h3>
                <button
                    type="button"
                    class="modal-close-btn"
                    data-action="live#action"
                    data-live-action-param="cancelDelete"
                >
                    {{ ux_icon('fa-solid:times') }}
                </button>
            </div>
            <div class="modal-body-custom">
                <p>
                    Êtes-vous certain de vouloir supprimer le tag <strong>« {{ this.deletingTag.name }} »</strong> ?
                </p>
                <p class="text-danger-warning">
                    {{ ux_icon('fa-solid:info-circle') }} Cette action est irréversible. Les entités associées ne contiendront plus ce tag.
                </p>
            </div>
            <div class="modal-footer-custom">
                <button
                    type="button"
                    class="btn-secondary"
                    data-action="live#action"
                    data-live-action-param="cancelDelete"
                >
                    Annuler
                </button>
                <button
                    type="button"
                    class="btn-danger-confirm"
                    data-action="live#action"
                    data-live-action-param="executeDelete"
                >
                    {{ ux_icon('fa-solid:trash-alt') }} Confirmer la suppression
                </button>
            </div>
        </div>
    {% endif %}

</div>
