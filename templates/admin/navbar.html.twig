<aside class="sidebar">
    <nav>
        <button class="sidebar-toggle">
            <i class="fas fa-bars"></i>
        </button>
        <div class="logo">
            <img src="/img/logo-placeholder.png" alt="Logo">
        </div>

        <div class="user-info">
            <div class="user-avatar">
                <i class="fas fa-user-circle"></i>
            </div>
            <div class="user-details">
                <p class="username">{{ app.user ? app.user.userIdentifier : 'Invité' }}</p>
                <p class="user-group">Administrateur</p>
            </div>
            <a href="{{ path('app_logout') }}" class="logout-btn" title="Déconnexion">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>

        {% set current_route = app.request.attributes.get('_route')|default('') %}

        <div class="nav-menu">
            <div class="nav-section">
                <h3>Administration</h3>
                <div class="nav-item">
                    <div class="nav-item-header">
                        <span>Utilisateurs</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="nav-item-content">
                        <a href="{{ path('admin_users_list') }}" class="{{ current_route starts with 'admin_users_' and not (current_route starts with 'admin_users_group_') and not (current_route starts with 'admin_users_role_') ? 'active' : '' }}">Utilisateurs</a>
                        <a href="{{ path('admin_users_group_list') }}" class="{{ current_route starts with 'admin_users_group_' ? 'active' : '' }}">Groupes</a>
                    </div>
                </div>
                <div class="nav-item">
                    <div class="nav-item-header">
                        <span>Tags</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="nav-item-content">
                        <a href="{{ path('admin_tags_list') }}" class="{{ current_route starts with 'admin_tags_' ? 'active' : '' }}">Gestion des Tags</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</aside>